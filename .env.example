BOT_TOKEN=
CHANNEL_USERNAME=@claudedry
# chat_id технического чата для модерации фидбэка (инструменты/промпты от пользователей).
# Пусто = фидбэк только логируется, не отправляется никуда. Для групп ID ОТРИЦАТЕЛЬНЫЙ
# (например -5386251457) — узнать: добавить бота в группу, написать в ней "/start@<bot_username>"
# (упоминание нужно из-за privacy mode) и посмотреть chat.id через getUpdates.
TECH_CHAT_ID=
DATABASE_URL=postgresql://user:pass@localhost:5432/botyard
REDIS_URL=redis://localhost:6379/0

# Токен для scripts/sync_github_stars.py. Нужен ТОЛЬКО ради лимита 5000 req/ч
# вместо 60: в каталоге 372 репозитория, без токена один прогон в лимит не влезает.
# Скрипт делает единственный вид запроса — GET /repos/{owner}/{name}, то есть
# читает публичные метаданные.
# ПРАВА: ни одного скоупа. Классический PAT с неотмеченными галочками либо
# fine-grained с доступом «Public repositories (read-only)» — лимит тот же.
# public_repo сюда НЕ выдавать: это запись во все публичные репозитории владельца.
# Пусто = скрипт работает без токена и упрётся в 60 req/ч.
GITHUB_TOKEN=
